{
  "name": "multivac",
  "version": "0.9.0",
  "description": "Brain-driven development CLI: one brain repo of claims, law and ritual, from which an ecosystem of code repos is developed. Deterministic verification, no model in the path.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "multivac": "dist/cli.js",
    "mvac": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/ulm0/multivac.git"
  },
  "homepage": "https://multivac.ulm0.com",
  "bugs": {
    "url": "https://gitlab.com/ulm0/multivac/-/issues"
  },
  "keywords": [
    "agents",
    "agentic",
    "spec-driven-development",
    "monorepo",
    "invariants",
    "knowledge-graph",
    "cli"
  ],
  "scripts": {
    "prebuild": "node -e \"for (const d of ['dist','dist-test']) require('fs').rmSync(d,{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "npm run build && node --test \"dist-test/**/*.test.js\"",
    "preinstall": "node -e \"if(process.env.INIT_CWD===process.cwd()&&!(process.env.npm_config_user_agent||'').startsWith('pnpm')){console.error('multivac develops with pnpm — run: corepack pnpm install');process.exit(1)}\""
  },
  "dependencies": {
    "citty": "^0.2.2",
    "picomatch": "^4.0.2",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/picomatch": "^3.0.1",
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@11.21.0"
}
